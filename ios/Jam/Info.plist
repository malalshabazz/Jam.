<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>jam</string>
          <string>com.jam.creators</string>
        </array>
      </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
      <key>NSAllowsLocalNetworking</key>
      <true/>
      <key>NSExceptionDomains</key>
      <dict>
        <key>cloudflarestream.com</key>
        <dict>
          <key>NSExceptionAllowsInsecureHTTPLoads</key>
          <false/>
          <key>NSIncludesSubdomains</key>
          <true/>
          <key>NSExceptionMinimumTLSVersion</key>
          <string>TLSv1.2</string>
          <key>NSExceptionRequiresForwardSecrecy</key>
          <true/>
        </dict>
        <key>upload.cloudflarestream.com</key>
        <dict>
          <key>NSExceptionAllowsInsecureHTTPLoads</key>
          <false/>
          <key>NSIncludesSubdomains</key>
          <true/>
          <key>NSExceptionMinimumTLSVersion</key>
          <string>TLSv1.2</string>
          <key>NSExceptionRequiresForwardSecrecy</key>
          <true/>
        </dict>
        <key>upload.videodelivery.net</key>
        <dict>
          <key>NSExceptionAllowsInsecureHTTPLoads</key>
          <false/>
          <key>NSIncludesSubdomains</key>
          <true/>
          <key>NSExceptionMinimumTLSVersion</key>
          <string>TLSv1.2</string>
          <key>NSExceptionRequiresForwardSecrecy</key>
          <true/>
        </dict>
        <key>videodelivery.net</key>
        <dict>
          <key>NSExceptionAllowsInsecureHTTPLoads</key>
          <false/>
          <key>NSIncludesSubdomains</key>
          <true/>
          <key>NSExceptionMinimumTLSVersion</key>
          <string>TLSv1.2</string>
          <key>NSExceptionRequiresForwardSecrecy</key>
          <true/>
        </dict>
      </dict>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Jam uses your camera so you can record videos for your profile and feed.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Jam updates your live location for nearby creators while share live location is enabled in settings.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Jam updates your live location for nearby creators while share live location is enabled in settings.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Jam uses your location to show creators near you and share your live location when enabled in settings.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Jam needs local network access to load the development server on your computer.</string>
    <key>NSBonjourServices</key>
    <array>
      <string>_expo._tcp</string>
      <string>_http._tcp</string>
    </array>
    <key>NSMicrophoneUsageDescription</key>
    <string>Jam uses your microphone so your videos can include sound.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Jam lets you choose videos and profile photos from your library.</string>
    <key>RCTNewArchEnabled</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>SplashScreen</string>
    <key>UIBackgroundModes</key>
    <array>
      <string>location</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
      <string>arm64</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
