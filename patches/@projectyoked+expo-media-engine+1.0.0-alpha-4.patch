+    /// Coerce JS / Expo dictionary numbers (Double, Int, NSNumber) into Double.
+    private static func doubleValue(_ value: Any?) -> Double? {
+        if let number = value as? NSNumber { return number.doubleValue }
+        if let number = value as? Double { return number }
+        if let number = value as? Int { return Double(number) }
+        if let number = value as? Float { return Double(number) }
+        return nil
+    }
+
+    /// Match Jam editor faces (System / Georgia / Menlo / Avenir / etc).
+    private static func resolveOverlayFont(family: String?, weight: String?, size: CGFloat) -> UIFont {
+        let normalizedFamily = (family ?? "")
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        if !normalizedFamily.isEmpty,
+           normalizedFamily.caseInsensitiveCompare("System") != .orderedSame,
+           let named = UIFont(name: normalizedFamily, size: size) {
+            return named
+        }
+
+        let normalizedWeight = (weight ?? "").trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        let uiWeight: UIFont.Weight
+        switch normalizedWeight {
+        case "900", "800", "black", "ultrabold", "heavy":
+            uiWeight = .black
+        case "700", "bold":
+            uiWeight = .bold
+        case "600", "semibold":
+            uiWeight = .semibold
+        case "500", "medium":
+            uiWeight = .medium
+        case "400", "normal", "regular":
+            uiWeight = .regular
+        case "300", "light":
+            uiWeight = .light
+        default:
+            // Jam "classic" preview uses weight 900.
+            uiWeight = .black
+        }
+        return UIFont.systemFont(ofSize: size, weight: uiWeight)
+    }
+
