{
  "name": "jam",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "node scripts/start-expo-lan.mjs",
    "dev:clear": "node scripts/start-expo-lan.mjs --clear",
    "dev:safe": "node scripts/start-expo-lan.mjs --clear",
    "dev:offline": "expo start --localhost --offline --clear",
    "dev:tunnel": "expo start --tunnel",
    "dev:localhost": "expo start --localhost",
    "dev:client": "expo start --dev-client",
    "dev:next": "next dev",
    "build": "expo export",
    "build:next": "next build",
    "build:dev:ios": "npx eas-cli build --platform ios --profile development",
    "build:dev:ios:sim": "npx eas-cli build --platform ios --profile development-simulator",
    "eas:login": "npx eas-cli login",
    "eas:init": "npx eas-cli init",
    "start": "node scripts/start-expo-lan.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "postinstall": "patch-package || (test \"$VERCEL\" = \"1\" && echo \"patch-package failed on Vercel — continuing\")",
    "migrate:avatars": "node scripts/migrate-profile-avatars-to-storage.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@projectyoked/expo-media-engine": "^1.0.0-alpha-4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "@supabase/supabase-js": "^2.106.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.35",
    "expo-asset": "12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "next": "16.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "eas-cli": "^21.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  }
}
